HELIOS_SERVER_ID=youer-main
HELIOS_TOKEN_SECRET=replace-with-at-least-32-random-bytes
HELIOS_BRIDGE_URL=https://127.0.0.1:8765
HELIOS_BRIDGE_SECRET=replace-with-the-same-bridge-secret-used-by-the-plugin-and-server-mod
HELIOS_TLS_CERT=C:\absolute\path\to\backend-cert.pem
HELIOS_TLS_KEY=C:\absolute\path\to\backend-key.pem
# Alternatively, set both HELIOS_TLS_PFX and HELIOS_TLS_PFX_PASSWORD instead
# of HELIOS_TLS_CERT/HELIOS_TLS_KEY. This is useful for a PKCS#12 deployment.
# HELIOS_TLS_PFX=C:\absolute\path\to\backend.p12
# HELIOS_TLS_PFX_PASSWORD=replace-with-the-pkcs12-password
HELIOS_AUTH_DATABASE=C:\absolute\path\to\data\helios-auth.sqlite
HELIOS_EMAIL_ENABLED=false
HELIOS_EMAIL_REQUIRED=false
HELIOS_RECOVERY_URL=https://accounts.example.com/recover
HELIOS_TRUST_PROXY=true
HOST=127.0.0.1
PORT=8443
