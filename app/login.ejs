<div id="loginContainer" style="display: none;">
    <div id="loginCancelContainer" style="display: none;">
        <button id="loginCancelButton">
            <div id="loginCancelIcon">X</div>
            <span id="loginCancelText"><%- lang('login.loginCancelText') %></span>
        </button>
    </div>
    <div id="loginContent">
        <form id="loginForm">
            <img id="loginImageSeal" src="assets/images/SealCircle.png"/>
            <span id="loginSubheader"><%- lang('login.loginSubheader') %></span>
            <div id="loginModeSelector">
                <button id="loginModeLogin" type="button" selected><%- lang('login.loginMode') %></button>
                <button id="loginModeRegister" type="button"><%- lang('login.registerMode') %></button>
            </div>
            <div class="loginFieldContainer">
                <span class="loginErrorSpan" id="loginUsernameError"><%- lang('login.loginUsernameError') %></span>
                <input id="loginUsername" class="loginField" type="text" maxlength="16" autocomplete="username" placeholder="<%- lang('login.loginUsernamePlaceholder') %>"/>
            </div>
            <div class="loginFieldContainer">
                <span class="loginErrorSpan" id="loginPasswordError"><%- lang('login.loginPasswordError') %></span>
                <input id="loginPassword" class="loginField" type="password" maxlength="128" autocomplete="current-password" placeholder="<%- lang('login.loginPasswordPlaceholder') %>"/>
            </div>
            <div class="loginFieldContainer" id="loginConfirmContainer" style="display: none;">
                <span class="loginErrorSpan" id="loginConfirmError"><%- lang('login.loginConfirmError') %></span>
                <input id="loginConfirmPassword" class="loginField" type="password" maxlength="128" autocomplete="new-password" placeholder="<%- lang('login.loginConfirmPlaceholder') %>"/>
            </div>
            <div class="loginFieldContainer" id="loginEmailContainer" style="display: none;">
                <span class="loginErrorSpan" id="loginEmailError"><%- lang('login.loginEmailError') %></span>
                <input id="loginEmail" class="loginField" type="email" maxlength="254" autocomplete="email" placeholder="<%- lang('login.loginEmailPlaceholder') %>"/>
            </div>
            <div id="loginOptions">
                <a id="loginForgotPassword" href="#" style="display: none;"><%- lang('login.loginForgotPasswordText') %></a>
            </div>
            <button id="loginButton" type="button" disabled>
                <div id="loginButtonContent">
                    <span id="loginButtonLabel"><%- lang('login.loginButtonText') %></span>
                    <svg id="loginSVG" viewBox="0 0 24.87 13.97">
                        <polyline class="arrowLine" points="0.71 13.26 12.56 1.41 24.16 13.02"/>
                    </svg>
                    <div class="circle-loader">
                        <div class="checkmark draw"></div>
                    </div>
                </div>
            </button>
            <div id="loginDisclaimer">
                <p class="loginDisclaimerText"><%- lang('login.loginPasswordDisclaimer1') %></p>
                <p class="loginDisclaimerText"><%- lang('login.loginPasswordDisclaimer2', { appName: lang('app.title') }) %></p>
            </div>
        </form>
    </div>
    <script src="./assets/js/scripts/login.js"></script>
</div>
